# Mithril environment variables
# Copy to .env and fill in your own API key.

# ─────────────────────────────────────────────────────────────────────────
# LLM provider — Google Gemini (hosted default)
# ─────────────────────────────────────────────────────────────────────────
#   Cognee uses litellm (needs the "gemini/" prefix); Mithril's own scoring
#   calls use Gemini's OpenAI-compatible endpoint automatically (the prefix is
#   stripped and the endpoint is inferred — no LLM_ENDPOINT needed for Gemini).
#   Get a key at https://aistudio.google.com/apikey
#   gemini-2.5-flash is fast + has free-tier budget; gemini-*-flash "thinking"
#   models are much slower and need more output tokens.
LLM_PROVIDER="gemini"
LLM_MODEL="gemini/gemini-2.5-flash"
LLM_API_KEY="your-google-ai-studio-key-here"

#   Multi-key rotation (optional): supply several keys and Mithril fails over to
#   the next when one is rate-limited. This only RAISES your ceiling if the keys
#   are from DIFFERENT Google projects (Gemini enforces quota per project, not
#   per key). Each key gets its own MITHRIL_LLM_RPM budget. LLM_API_KEY above is
#   used for Cognee's own calls (and as the single-key fallback).
# LLM_API_KEYS="key_from_project_1,key_from_project_2,key_from_project_3"

#   Output-token budget per scoring call. Raise for thinking models that spend
#   tokens reasoning before answering (empty output → fallback score).
MITHRIL_LLM_MAX_TOKENS="800"

# ── ALT — any OpenAI-compatible gateway (AgentRouter, OpenRouter, Ollama). ───
# LLM_PROVIDER="custom"
# LLM_MODEL="openai/gpt-4o-mini"
# LLM_ENDPOINT="https://agentrouter.org/v1"
# LLM_API_KEY="your-openai-compatible-key-here"

# ─────────────────────────────────────────────────────────────────────────
# Embedding provider
# ─────────────────────────────────────────────────────────────────────────
#   Local embeddings (no API key, no quota) — keeps the LLM key above the only
#   key Mithril needs. Gemini's embedding endpoint is not required.
EMBEDDING_PROVIDER="fastembed"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
EMBEDDING_DIMENSIONS="384"

# ─────────────────────────────────────────────────────────────────────────
# Rate limiting (protect the shared Gemini free-tier quota)
# ─────────────────────────────────────────────────────────────────────────
#   Mithril's own limiter guards the 2 scoring calls it makes per remember().
#   Keep MITHRIL_LLM_RPM a little BELOW the real Gemini limit so Cognee's own
#   cognify calls (which share the same upstream quota) have headroom.
MITHRIL_LLM_RPM="4"
MITHRIL_LLM_INTERVAL_SECONDS="60"

#   Cognee's built-in limiter — the deep backstop for its internal cognify calls.
LLM_RATE_LIMIT_ENABLED="true"
LLM_RATE_LIMIT_REQUESTS="5"
LLM_RATE_LIMIT_INTERVAL="60"

# ─────────────────────────────────────────────────────────────────────────
# Hosting / public demo
# ─────────────────────────────────────────────────────────────────────────
#   Comma-separated hosted frontend origins (added to localhost dev origins).
#   Use "*" to allow any origin (disables credentialed CORS).
CORS_ORIGINS="https://your-frontend.vercel.app"

#   Seed the verified-memory baseline once at startup so public visitors only
#   spend budget on the single claim they submit.
MITHRIL_DEMO_SEED="true"

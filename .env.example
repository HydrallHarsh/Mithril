# Mithril environment variables
# Copy to .env and fill in your API key

# LLM provider (via OpenRouter)
LLM_PROVIDER="custom"
LLM_MODEL="openrouter/nvidia/nemotron-3-ultra-550b-a55b:free"
LLM_ENDPOINT="https://openrouter.ai/api/v1"
LLM_API_KEY="your-openrouter-api-key-here"

# Embedding provider (via OpenRouter)
EMBEDDING_PROVIDER="custom"
EMBEDDING_MODEL="openrouter/nvidia/llama-nemotron-embed-vl-1b-v2:free"
EMBEDDING_API_KEY="your-embedding-api-key-here"
EMBEDDING_DIMENSIONS="1536"

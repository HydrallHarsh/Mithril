# Mithril environment variables
# Copy to .env and fill in your API key.

# ─────────────────────────────────────────────────────────────────────────
# LLM provider
# ─────────────────────────────────────────────────────────────────────────
# NEW — AgentRouter (OpenAI-compatible chat gateway: Claude/GPT/DeepSeek/…)
#   Base URL: https://agentrouter.org/v1  ·  auth: Bearer <key>
#   Model names are bare (e.g. gpt-4o-mini, claude-sonnet-4-5-20250929).
#   The "openai/" prefix tells Cognee's litellm to treat AgentRouter as an
#   OpenAI-compatible endpoint; Mithril strips the prefix for its own call.
LLM_PROVIDER="custom"
LLM_MODEL="openai/gpt-5.5"
LLM_ENDPOINT="https://agentrouter.org/v1"
LLM_API_KEY="sk-g6JthYSD39rowOrd7QMc69v4Y9qmNPsHJqCbhOtZK1C9F48k"
# Alternatives: openai/claude-sonnet-4-5-20250929 · openai/deepseek-r1 · openai/gpt-4o

# OLD — OpenRouter (kept for reference; uncomment to switch back)
# LLM_PROVIDER="custom"
# LLM_MODEL="openrouter/nvidia/nemotron-3-ultra-550b-a55b:free"
# LLM_ENDPOINT="https://openrouter.ai/api/v1"
# LLM_API_KEY="your-openrouter-api-key-here"

# ─────────────────────────────────────────────────────────────────────────
# Embedding provider
# ─────────────────────────────────────────────────────────────────────────
# NOTE: AgentRouter does not expose a documented embeddings endpoint, so
# embeddings use a different provider than the LLM above.
#
# OPTION B (active, recommended) — local embeddings, NO API key.
#   Requires:  uv pip install fastembed   (downloads ~90MB model on first run)
#   With this, the AgentRouter key above is the ONLY key Mithril needs.
EMBEDDING_PROVIDER="fastembed"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
EMBEDDING_DIMENSIONS="384"
#
# OPTION A (fallback) — OpenRouter for embeddings only (needs an OpenRouter key).
# EMBEDDING_PROVIDER="custom"
# EMBEDDING_MODEL="openrouter/nvidia/llama-nemotron-embed-vl-1b-v2:free"
# EMBEDDING_ENDPOINT="https://openrouter.ai/api/v1"
# EMBEDDING_API_KEY="your-openrouter-api-key-here"
# EMBEDDING_DIMENSIONS="1536"
